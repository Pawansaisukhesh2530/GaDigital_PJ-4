# Large QuickTime source files that exceed GitHub's 100MB per-file limit.
# The browser-compatible .mp4 encodes ARE committed (they are needed by
# projects.php and gallery.php).
assets/videos/*.mov

# OS / editor junk
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
.DS_Store
*.tmp

# Local runtime artifacts
config/smtp.php
storage/logs/email.log
storage/sessions/*
uploads/resumes/*
# Keep the web-access-blocking placeholders versioned so every clone
# (and every Docker image built from a clone) protects the uploads dir.
!uploads/resumes/.htaccess
!uploads/resumes/index.html

# IDE config
.continue/
